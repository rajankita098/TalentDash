// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Level {
  L3
  L4
  L5
  L6
  SDE_I
  SDE_II
  SDE_III
  STAFF
  PRINCIPAL
  IC4
  IC5
}

enum Currency {
  INR
  USD
  GBP
  EUR
}

enum Source {
  CONTRIBUTOR
  SCRAPED
  AI_INFERRED
}

model Company {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   // Display name (e.g., "Google India")
  slug            String   @unique // URL matching slug (e.g., "google")
  normalizedName  String   @map("normalized_name") // Lowercase indexed for exact lookups
  industry        String
  headquarters    String
  foundedYear     Int?     @map("founded_year")
  headcountRange  String?  @map("headcount_range")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // One-to-many relation block
  salaries        Salary[]

  @@index([normalizedName])
}

model Salary {
  id                String   @id @default(uuid())
  companyId         String
  role              String
  level             Level
  location          String
  currency          Currency
  experienceYears   Int
  baseSalary        BigInt
  bonus             BigInt
  stock             BigInt
  totalCompensation BigInt
  source            Source   @default(SCRAPED)
  confidenceScore   Float
  isVerified        Boolean  @default(false)
  submittedAt       DateTime @default(now())

  company           Company  @relation(fields: [companyId], references: [id])

  // Performance Optimization Indexes for B3
  @@index([role])
  @@index([location])
  @@index([level])
  @@index([totalCompensation])
  @@index([submittedAt])
}